# w17-owned transient + local-secret paths — machine-local, never commit.
# Generated by w17ctl (init). Safe to edit — w17ctl only APPENDS missing
# lines, never rewrites yours. Scoped to the w17/ tree; the patterns are
# relative, so `.env` / `.secrets` also cover the per-bundle copies under
# w17/services/*/ (the committed *.defaults / *.example templates stay tracked).

# Dev DB snapshots — disposable branch-scoped scratch (dev DB lifecycle).
tmp/

# Local dev PKI (self-signed CA + server leaf) — machine-local TLS material.
certs/dev.local/

# Private-surface dev PKI (CA + a leaf per caller) — machine-local key material.
certs/private/

# age secret keys — private key material, mounted at deploy, never committed.
keys/

# Local env + secrets. The committed *.defaults / *.example templates are the
# tracked source; the filled-in local copies below stay out of git.
.env

.env.local

.secrets

# Generated service bundles — rebuilt by `w17ctl codegen`.
/services/

# The w17-owned Go stub module (pb + grpc clients).
/stubs/

# Vendored @w17/admin-runtime — a verbatim copy, never edited here.
/admin-runtime/

# Generated front-end clients.
/web-client/

/js-client/

# The platform reference + project map — refreshed from the console every codegen.
/specs/

/map/

/AGENTS.md

# Base rsync ignore for `w17ctl stack` remote mode — regenerated every codegen.
/rsync.ignore
